---
interface Props {
	title?: string;
	description?: string;
}
const {
	title = "Cat Tran · Product Designer",
	description = "Cat Tran designs kind, effortless experiences and robust systems for rapidly scaling organizations.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Literata:opsz,wght@7..72,400;7..72,500&display=swap"
		/>
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--font-sans: "IBM Plex Sans", ui-sans-serif, system-ui, -apple-system,
			"Segoe UI", Roboto, sans-serif;
		--font-serif: "Literata", Georgia, "Times New Roman", serif;
		--edge: clamp(24px, 4vw, 72px);
		--paper: #f8f4ed;
		--ink: #2a2724;
		--body-text: #38332e;
		--terracotta: #cb5e3c;
		--terracotta-ink: #a8451e;
		--warm-grey: #6f6252;
		--hairline: #e6ddcc;
		--surface: #fdfbf6;
		--sage-ui: #5e8e72;
		--sage-ui-hover: #466d57;
		--underline: #c9bfae;
		--nav-glass: rgba(248, 244, 237, 0.92);
		--shadow: rgba(42, 39, 36, 0.12);
	}
	:root[data-theme="dark"] {
		--paper: #1a1816;
		--ink: #f3ede4;
		--body-text: #e2dbd0;
		--terracotta: #d4918e;
		--terracotta-ink: #d4918e;
		--warm-grey: #8cc49f;
		--hairline: #3a3530;
		--surface: #262320;
		--sage-ui: #8cc49f;
		--sage-ui-hover: #addbbd;
		--underline: #5e564c;
		--nav-glass: rgba(26, 24, 22, 0.88);
		--shadow: rgba(0, 0, 0, 0.35);
		color-scheme: dark;
	}
	/* Light cards (diagrams, the sandbox) keep the light palette inside them. */
	.light-surface {
		--paper: #f8f4ed;
		--ink: #2a2724;
		--body-text: #38332e;
		--terracotta: #cb5e3c;
		--terracotta-ink: #a8451e;
		--warm-grey: #6f6252;
		--hairline: #e6ddcc;
		--surface: #fdfbf6;
		color: var(--ink);
		color-scheme: light;
	}
	@media (max-width: 640px) {
		:root {
			--edge: 14px;
		}
	}
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
	body {
		font-family: var(--font-sans);
		background: var(--paper);
		color: var(--ink);
	}
	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}
	html {
		scroll-padding-top: 88px;
	}
</style>
