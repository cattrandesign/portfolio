---
interface Props {
  /** "horizontal" runs left→right; "vertical" runs top→bottom. */
  orientation?: "horizontal" | "vertical";
  /** Pin to the viewport so it stays visible while the page scrolls. */
  fixed?: boolean;
  /** Which side to pin a fixed vertical rail to. */
  side?: "left" | "right";
  /** Width of a fixed vertical rail in px. */
  rail?: number;
  /** Gap between the pinned edge and the rail (any CSS length, e.g. "48px" or "var(--edge)"). */
  inset?: string;
  /** Progress source: "self" = this element's scroll position; "page" = whole-page scroll. */
  track?: "self" | "page";
  /** Cross-axis size of the drawing area in px (ignored for a fixed vertical rail). */
  height?: number;
  /** Peak cross-axis excursion of the tangle in px. */
  amplitude?: number;
  /** How far each strand wanders along its axis, as a fraction of the axis length. */
  reach?: number;
  /** How many full loops the scribble makes over its length. */
  loops?: number;
  /** Number of overlapping strands. */
  strands?: number;
  /** Stroke colors, one per strand (last is drawn on top). */
  colors?: string[];
  /** Stroke thickness in px. */
  weight?: number;
  /** Cross-axis gap between strands once resolved (0 = merge into one line). */
  resolveGap?: number;
  /** Lock to a fixed progress (0 = tangled, 1 = resolved) and skip scroll tracking. */
  progress?: number;
  /** CSS selector for an element the start (top) of the line should terminate on. */
  anchor?: string;
  /** Extra class on the wrapper. */
  class?: string;
}

const {
  orientation = "horizontal",
  fixed = false,
  side = "left",
  rail = 120,
  inset = "0",
  track = fixed ? "page" : "self",
  height = 130,
  amplitude = 26,
  reach = 0.11,
  loops = 3,
  strands = 3,
  colors = ["#72A085", "#CB5E3C", "#2A2724"],
  weight = 2,
  resolveGap = 0,
  progress: forced,
  anchor,
  class: className = "",
} = Astro.props;

const palette = Array.from(
  { length: strands },
  (_, i) => colors[i % colors.length],
);

const isRail = fixed && orientation === "vertical";
---

<div
  class:list={[
    "squiggle-line",
    orientation,
    { "is-fixed": fixed, "is-rail": isRail, [`side-${side}`]: isRail },
    className,
  ]}
  style={isRail ? `--rail-w:${rail}px;--rail-inset:${inset}` : undefined}
  data-squiggle
  data-orientation={orientation}
  data-track={track}
  data-height={height}
  data-amplitude={amplitude}
  data-reach={reach}
  data-loops={loops}
  data-strands={strands}
  data-weight={weight}
  data-resolve-gap={resolveGap}
  data-forced={forced}
  data-anchor={anchor}
>
  <svg
    preserveAspectRatio="none"
    shape-rendering="geometricPrecision"
    aria-hidden="true"
  >
    {
      palette.map((c, i) => (
        <path
          fill="none"
          stroke={c}
          stroke-width={
            palette.length > 1 && i === palette.length - 1
              ? weight + 0.4
              : weight
          }
          stroke-linecap="round"
          stroke-linejoin="round"
          vector-effect="non-scaling-stroke"
          shape-rendering="geometricPrecision"
        />
      ))
    }
  </svg>
</div>

<style>
  .squiggle-line {
    line-height: 0;
  }
  .squiggle-line.horizontal {
    width: 100%;
  }
  .squiggle-line.vertical {
    height: 100%;
  }
  .squiggle-line svg {
    display: block;
    overflow: visible;
  }
  .squiggle-line.horizontal svg {
    width: 100%;
  }
  .squiggle-line.vertical svg {
    height: 100%;
  }
  .squiggle-line.is-fixed {
    position: fixed;
    pointer-events: none;
    z-index: 1;
  }
  .squiggle-line.is-rail {
    top: 0;
    width: var(--rail-w, 120px);
    height: 100vh;
    height: 100dvh;
  }
  .squiggle-line.is-rail.side-left {
    left: var(--rail-inset, 0);
  }
  .squiggle-line.is-rail.side-right {
    right: var(--rail-inset, 0);
  }
  .squiggle-line.is-rail svg {
    width: 100%;
    height: 100%;
  }
</style>

<script>
  type Strand = {
    phase: number;
    fMul: number;
    lane: number;
  };

  type Inst = {
    el: HTMLElement;
    svg: SVGSVGElement;
    paths: SVGPathElement[];
    strands: Strand[];
    vertical: boolean;
    track: string;
    N: number;
    cross: number;
    amplitude: number;
    reach: number;
    loops: number;
    resolveGap: number;
    w: number;
    h: number;
    startY: number;
    progress: number;
    anchorSel: string | null;
    anchor: [number, number] | null;
  };

  const TAU = Math.PI * 2;
  const FEATHER = 0.34;
  const ANCHOR_SPAN = 0.16;
  // Amount of secondary sway riding on the main loop (0 = perfect coil).
  const WOBBLE = 0.14;

  function smooth(t: number) {
    if (t <= 0) return 0;
    if (t >= 1) return 1;
    return t * t * (3 - 2 * t);
  }

  function makeStrands(count: number): Strand[] {
    const out: Strand[] = [];
    for (let k = 0; k < count; k++) {
      const f = count > 1 ? k / (count - 1) : 0.5;
      out.push({
        // Evenly staggered so the strands braid rather than scatter.
        phase: f * Math.PI * 1.15,
        // Tiny spread in loop rate so they drift gently in and out of sync.
        fMul: 1 + (f - 0.5) * 0.1,
        lane: count === 1 ? 0 : f * 2 - 1,
      });
    }
    return out;
  }

  function offsets(
    s: Strand,
    t: number,
    along: number,
    crossAmp: number,
    loops: number,
  ) {
    const a = TAU * loops * s.fMul * t + s.phase;
    const wobble = WOBBLE * Math.sin(2 * a + s.phase);
    const alongWander = along * (Math.sin(a) + wobble);
    const crossWander = crossAmp * (Math.cos(a) - wobble);
    return [alongWander, crossWander];
  }

  function catmullRom(pts: number[][]) {
    if (pts.length < 2) return "";
    let d = `M ${pts[0][0].toFixed(2)} ${pts[0][1].toFixed(2)}`;
    for (let i = 0; i < pts.length - 1; i++) {
      const p0 = pts[i - 1] || pts[i];
      const p1 = pts[i];
      const p2 = pts[i + 1];
      const p3 = pts[i + 2] || pts[i + 1];
      const c1x = p1[0] + (p2[0] - p0[0]) / 6;
      const c1y = p1[1] + (p2[1] - p0[1]) / 6;
      const c2x = p2[0] - (p3[0] - p1[0]) / 6;
      const c2y = p2[1] - (p3[1] - p1[1]) / 6;
      d += ` C ${c1x.toFixed(2)} ${c1y.toFixed(2)}, ${c2x.toFixed(2)} ${c2y.toFixed(2)}, ${p2[0].toFixed(2)} ${p2[1].toFixed(2)}`;
    }
    return d;
  }

  function buildStrand(inst: Inst, s: Strand, p: number) {
    const { N, w, h, amplitude, reach, loops, resolveGap, vertical, anchor } =
      inst;
    const alongLen = vertical ? h : w;
    const crossSize = vertical ? w : h;
    const pad = Math.min(30, alongLen * 0.04);
    const crossCenter = vertical
      ? Math.min(crossSize * 0.5, 54)
      : crossSize / 2;
    const reachPx = Math.max(46, Math.min(280, alongLen * reach));
    // Headroom at the start so the first upward loop doesn't clip off the edge.
    const padStart = Math.min(alongLen * 0.42, Math.max(pad, reachPx * 0.85 + 20));
    const front = p * (1 + FEATHER);
    const lo = 5;
    const hi = crossSize - 5;
    const aLo = 6;
    const aHi = alongLen - 6;
    // On a wide rail, let the loops live out in the open space rather than
    // jammed against the near edge: drift the loop centre away from the
    // resolved line once past the anchor, then ease back before the tail.
    const drift = Math.max(0, Math.min(crossSize * 0.3, (crossSize - 90) * 0.6));
    const pts: number[][] = [];
    for (let i = 0; i < N; i++) {
      const u = i / (N - 1);
      const baseAlong = padStart + u * (alongLen - padStart - pad);
      const resolvedCross = crossCenter + s.lane * resolveGap;
      const straighten = smooth((front - u) / FEATHER);
      const tangle = 1 - straighten;
      const taper = smooth(Math.min(u, 1 - u) / 0.12);
      const loopShift =
        drift * smooth((u - 0.08) / 0.22) * smooth((0.94 - u) / 0.16);
      const [aw, cw] = offsets(s, u, reachPx, amplitude, loops);
      let alongPos = baseAlong + aw * tangle * taper;
      let crossPos = resolvedCross + (loopShift + cw) * tangle * taper;
      if (crossPos < lo) crossPos = lo;
      if (crossPos > hi) crossPos = hi;
      if (alongPos < aLo) alongPos = aLo;
      if (alongPos > aHi) alongPos = aHi;
      let x = vertical ? crossPos : alongPos;
      let y = vertical ? alongPos : crossPos;
      if (anchor) {
        const a = smooth((ANCHOR_SPAN - u) / ANCHOR_SPAN);
        x += (anchor[0] - x) * a;
        y += (anchor[1] - y) * a;
      }
      pts.push([x, y]);
    }
    return catmullRom(pts);
  }

  function render(inst: Inst) {
    for (let k = 0; k < inst.strands.length; k++) {
      inst.paths[k].setAttribute(
        "d",
        buildStrand(inst, inst.strands[k], inst.progress),
      );
    }
  }

  function measure(inst: Inst) {
    const w = inst.el.clientWidth;
    const h = inst.el.clientHeight || Number(inst.el.dataset.height) || 130;
    if (w < 2 || h < 2) return;
    inst.w = w;
    inst.h = h;
    const rect = inst.el.getBoundingClientRect();
    inst.startY = rect.top + (window.scrollY || window.pageYOffset || 0);
    inst.anchor = null;
    if (inst.anchorSel) {
      const target = document.querySelector(inst.anchorSel);
      if (target) {
        const t = target.getBoundingClientRect();
        inst.anchor = [
          t.left + t.width / 2 - rect.left,
          t.top + t.height / 2 - rect.top,
        ];
      }
    }
    inst.svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
    render(inst);
  }

  function scrollProgress(inst: Inst) {
    const scrollY = window.scrollY || window.pageYOffset || 0;
    if (inst.track === "page") {
      const doc = document.documentElement;
      const max = doc.scrollHeight - window.innerHeight;
      return max > 0 ? Math.max(0, Math.min(1, scrollY / max)) : 1;
    }
    const vh = window.innerHeight || 1;
    const distance = vh * 0.42;
    const trigger = inst.startY < vh ? 0 : inst.startY - vh * 0.85;
    return Math.max(0, Math.min(1, (scrollY - trigger) / distance));
  }

  function init(el: HTMLElement) {
    const svg = el.querySelector("svg") as SVGSVGElement;
    const count = Number(el.dataset.strands) || 3;
    const inst: Inst = {
      el,
      svg,
      paths: Array.from(svg.querySelectorAll("path")),
      strands: makeStrands(count),
      vertical: el.dataset.orientation === "vertical",
      track: el.dataset.track || "self",
      N: 80,
      cross: Number(el.dataset.height) || 130,
      amplitude: Number(el.dataset.amplitude) || 26,
      reach: Number(el.dataset.reach) || 0.11,
      loops: Number(el.dataset.loops) || 3,
      resolveGap: Number(el.dataset.resolveGap ?? 0),
      w: 1,
      h: 130,
      startY: 0,
      progress: 0,
      anchorSel: el.dataset.anchor || null,
      anchor: null,
    };

    const forced = el.dataset.forced;
    if (forced !== undefined && forced !== "") {
      inst.progress = Math.max(0, Math.min(1, Number(forced)));
      measure(inst);
      if ("ResizeObserver" in window) {
        const ro = new ResizeObserver(() => {
          if (inst.el.clientWidth > 1 && inst.el.clientHeight > 1) measure(inst);
        });
        ro.observe(inst.el);
      }
      return;
    }

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      inst.progress = 1;
      measure(inst);
      return;
    }

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        inst.progress = scrollProgress(inst);
        render(inst);
        ticking = false;
      });
    };

    const remeasure = () => {
      measure(inst);
      inst.progress = scrollProgress(inst);
      render(inst);
    };

    if ("ResizeObserver" in window) {
      const ro = new ResizeObserver(() => {
        if (inst.el.clientWidth > 1 && inst.el.clientHeight > 1) remeasure();
      });
      ro.observe(inst.el);
    } else {
      window.addEventListener("resize", remeasure);
    }
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) remeasure();
    });
    window.addEventListener("pageshow", remeasure);

    window.addEventListener("scroll", onScroll, { passive: true });
    measure(inst);
    onScroll();
  }

  document
    .querySelectorAll<HTMLElement>("[data-squiggle]")
    .forEach((el) => init(el));
</script>
