---
import Layout from "../layouts/Layout.astro";
import SquiggleLine from "../components/SquiggleLine.astro";

const meta = [
  { label: "Based in", parts: ["Ellenville, New York"] },
  { label: "Currently", parts: ["Product Designer @ Healthie"] },
  {
    label: "Previously",
    parts: ["NYU Langone Health", "Trestle Collaborative", "Zapier", "Meta"],
  },
  {
    label: "Building",
    parts: ["Clarity", "AI-native", "design systems", "information architecture"],
  },
];

const navLinks = [
  { href: "#case-studies", label: "Case studies" },
  { href: "#clients", label: "Clients" },
  { href: "#about", label: "About" },
  { href: "#contact", label: "Contact" },
];

const sections = [
  {
    id: "case-studies",
    k: "Case studies",
    t: "Selected work in kind, scalable service design.",
  },
  { id: "clients", k: "Clients", t: "Teams I've partnered with along the way." },
  { id: "about", k: "About", t: "A designer who likes untangling things." },
  { id: "contact", k: "Contact", t: "Let's find a way to work together." },
];
---

<Layout>
  <a class="skip" href="#hero">Skip to content</a>

  <nav aria-label="Primary">
    <a class="logo" href="#hero" aria-label="Cat Tran — back to top">
      <span aria-hidden="true">ct</span>
    </a>

    <ul class="nav-group">
      {
        navLinks.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>

  <SquiggleLine
    orientation="vertical"
    fixed
    side="left"
    rail={260}
    inset="var(--edge)"
    amplitude={52}
    reach={0.2}
    anchor=".logo"
  />

  <main class="wrap">
    <section id="hero" class="hero">
      <div class="headline">
        <h1>Hi! I'm Cat.</h1>
        <p class="tagline">
          I design kind, scalable services for mission-driven organizations.
        </p>
      </div>

      <dl class="meta">
        {
          meta.map((row) => (
            <div class="row">
              <dt>
                {row.label} <span class="arrow">&rarr;</span>
              </dt>
              <dd>
                {row.parts.map((p, i) => (
                  <>
                    {i > 0 && (
                      <>
                        <span class="vh">, </span>
                        <svg class="sep" viewBox="0 0 32 29" aria-hidden="true">
                          <path d="M16 27C16 27 2.5 18.5 2.5 9.5C2.5 4.8 6 2 9.8 2C12.7 2 15 4 16 6.2C17 4 19.3 2 22.2 2C26 2 29.5 4.8 29.5 9.5C29.5 18.5 16 27 16 27Z" />
                        </svg>
                      </>
                    )}
                    <b>{p}</b>
                  </>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    {
      sections.map((s) => (
        <section id={s.id} class="panel">
          <p class="eyebrow">{s.k}</p>
          <p class="line">{s.t}</p>
        </section>
      ))
    }
  </main>
</Layout>

<style>
  :global(:root) {
    --edge: clamp(24px, 4vw, 72px);
  }
  :global(html) {
    scroll-padding-top: 88px;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html) {
      scroll-behavior: smooth;
    }
  }
  :global(body) {
    background: #f8f4ed;
  }

  .skip {
    position: absolute;
    left: 16px;
    top: -48px;
    z-index: 20;
    background: #2a2724;
    color: #f8f4ed;
    padding: 8px 14px;
    border-radius: 6px;
    font-family:
      ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    font-size: 14px;
    transition: top 0.15s ease;
  }
  .skip:focus {
    top: 12px;
  }

  nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 20px clamp(28px, 5vw, 88px) 20px calc(var(--edge) + 36px);
    pointer-events: none;
    font-family:
      ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  .nav-group {
    pointer-events: auto;
    display: flex;
    gap: 26px;
    margin: 0;
    padding: 11px 20px;
    list-style: none;
    background: rgba(248, 244, 237, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 999px;
  }
  nav a {
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-group a {
    color: #2a2724;
    font-size: 15px;
  }
  .nav-group a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .logo {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex: none;
    background: #72a085;
    border-radius: 50%;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 17px;
    letter-spacing: 0.03em;
    color: #2a2724;
  }
  nav a:focus-visible,
  .skip:focus-visible {
    outline: 2px solid #2a2724;
    outline-offset: 4px;
    border-radius: 2px;
  }
  .logo:focus-visible {
    border-radius: 50%;
  }

  .wrap {
    position: relative;
    z-index: 2;
    max-width: 700px;
    margin: 0 auto;
    padding: 0 clamp(28px, 5vw, 88px) 0 calc(var(--edge) + clamp(96px, 11vw, 176px));
    color: #2a2724;
  }
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 40px;
  }
  .headline {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  h1 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
    color: #cb5e3c;
  }
  .tagline {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(20px, 2.4vw, 28px);
    line-height: 1.4;
    letter-spacing: -0.01em;
    margin: 0;
    max-width: 26ch;
    color: #2a2724;
  }
  .meta {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family:
      ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    font-size: 14.5px;
  }
  .row {
    display: flex;
    gap: 8px;
  }
  dt {
    color: #a8451e;
    white-space: nowrap;
  }
  .arrow {
    color: #6f6252;
  }
  dd {
    margin: 0;
    color: #2a2724;
  }
  dd b {
    font-weight: 600;
  }
  .sep {
    width: 10px;
    height: 10px;
    margin: 0 8px;
    fill: #a8451e;
    vertical-align: -1px;
  }
  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .panel {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .eyebrow {
    font-family:
      ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #a8451e;
    margin: 0 0 12px;
  }
  .line {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(24px, 3.2vw, 38px);
    line-height: 1.4;
    margin: 0;
  }

  @media (max-width: 640px) {
    :global(:root) {
      --edge: 14px;
    }
    nav {
      gap: 12px;
      padding: 12px 16px 12px calc(var(--edge) + 22px);
    }
    .nav-group {
      gap: 14px;
      padding: 9px 14px;
    }
    .nav-group a {
      font-size: 13px;
    }
    .wrap {
      padding-left: calc(var(--edge) + 84px);
    }
    .row {
      flex-direction: column;
      gap: 2px;
    }
  }
</style>
