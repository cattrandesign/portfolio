---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import SquiggleLine from "../components/SquiggleLine.astro";
import VennDivider from "../components/VennDivider.astro";

const meta = [
  { label: "Based in", parts: ["Ellenville, New York"] },
  { label: "Currently", parts: ["Product Designer @ Healthie"] },
  {
    label: "Building",
    parts: ["Clarity", "AI-native design", "Design systems"],
  },
];

const caseStudies = [
  {
    client: "Enterprise healthcare app",
    slug: "/work/design-system",
    locked: true,
    title: "Piloting an AI-native design system workflow",
    meta: "2026",
    tint: "#E7E3D6",
    ratio: "4 / 3",
    logo: {
      src: "/logos/enterprise-banners.svg",
      alt: "Illustration of four generic banners: info, success, warning, and error",
      width: 800,
      height: 600,
      cover: true,
    },
  },
  {
    client: "NYU Langone Health",
    slug: "/work/nyu-langone",
    locked: true,
    title:
      "Designing multi-stakeholder scheduling software for nursing departments",
    meta: "2023",
    tint: "#580F8B",
    logo: { src: "/logos/nyu-langone.png", width: 560, height: 300 },
  },
  {
    client: "Daisychain via Trestle Collaborative",
    slug: "/work/daisychain",
    title: "Designing a dashboard for election text campaigns",
    meta: "2024",
    tint: "#F6F4F4",
    logo: {
      src: "/logos/daisychain-dashboard.jpg",
      alt: "Daisychain dashboard",
      width: 1356,
      height: 678,
      cover: true,
      edge: true,
    },
  },
  {
    client: "KettleOS",
    slug: "/work/kettleos",
    title: "Rethinking the admin information architecture and design system",
    meta: "2021",
    tint: "#FFFFFF",
    logo: { src: "/logos/kettle.png", width: 410, height: 120, edge: true },
  },
  {
    client: "Instagram",
    slug: "/work/instagram",
    title: "Surfacing insights on hacked accounts",
    meta: "2017",
    tint: "#E1306C",
    logo: { src: "/logos/instagram.jpg", width: 740, height: 740, cover: true },
  },
  {
    client: "New York State of Health",
    minor: true,
    title: "Simplifying the insurance marketplace",
    meta: "Self-initiated · 2022",
    tint: "#FFFFFF",
    logo: {
      src: "/logos/nysoh-after.jpg",
      alt: "Redesigned New York State of Health homepage",
      width: 837,
      height: 279,
      cover: true,
      edge: true,
    },
    external: {
      href: "https://uxplanet.org/ux-case-study-redesign-of-the-new-york-state-of-health-homepage-b92194b516b9",
      label: "Published in UX Planet",
    },
  },
  {
    client: "Zapier",
    minor: true,
    title: "Making automation feel approachable",
    note: "Coming soon",
    meta: "2020",
    tint: "#FFFDF9",
    logo: { src: "/logos/zapier.png", width: 1140, height: 360, edge: true },
  },
];

const contacts = [
  { k: "Email", label: "hello@cattran.design", href: "mailto:hello@cattran.design" },
  {
    k: "LinkedIn",
    label: "linkedin.com/in/catntran",
    href: "https://www.linkedin.com/in/catntran/",
    external: true,
  },
  {
    k: "Medium",
    label: "medium.com/@catntran",
    href: "https://medium.com/@catntran",
    external: true,
  },
];

const testimonials = [
  {
    quote:
      "During the 2 years I worked with Cat, she was instrumental in helping NYU Langone grow and mature our UX Research practice with new methods and a holistic approach. Cat implemented several large-scale efforts including conducting tree test analyses to optimize the main site navigation and launching a site-wide user feedback survey that has led to the uptake of several new initiatives.",
    name: "Meredith Blake",
    role: "UX Design, NYU Langone Health",
  },
  {
    quote:
      "Collaborating with Cat has been so effortless, and I quickly felt as if we'd worked together for ages. She readily adapted to the various needs of the project, and her passion for the organizing issues central to it really shone throughout.",
    name: "Jierui Fang",
    role: "UX Design, Trestle Collaborative",
  },
  {
    quote:
      "Working with Cat was a game-changer for our team. She possesses an exceptional ability to understand and connect with users, creating experiences that truly make an impact. An absolute pleasure to collaborate with!",
    name: "Tanja Thorsteinsson",
    role: "UX Design, NYU Langone Health",
  },
  {
    quote:
      "Cat designed a large system to automate our front office daily operations and saved us countless hours of time. Her enthusiasm, knowledge, and flexibility are some of the reasons I keep working with her. She is very easy to work with and a great communicator. Brainstorming with her is a breeze. If you have the opportunity to work with Cat, go for it!",
    name: "Angeliki Mavrikou",
    role: "Enterprise Systems, Mindpath Health",
  },
  {
    quote:
      "What truly distinguishes Cat is her ability to balance user needs and business goals, particularly in making tech accessible and equitable.",
    name: "Brandon Sanchez",
    role: "UX Research, Reddit",
  },
  {
    quote:
      "Working with Cat was the step I needed to take my online presence to the next level. From the start, I was thoughtfully guided through her research and development process, building on my core concept, ideals and most importantly, my future goals for the business.",
    name: "Linh Nguyen",
    role: "Manager, Au Lac Restaurant",
  },
  {
    quote:
      "I wasn't proud to share my website until Cat redesigned it. I linked my website out to promoters following the redesign, and since then, I've booked to open for Sofi Tukker, Megan Thee Stallion, Twitchcon, and Society of Women Engineers' WE23, the world's largest conference for women in engineering and technology. They definitely browsed the hell out of my website and social channels cause they referenced it a lot.",
    name: "DJ Lani Love",
    role: "",
  },
  {
    quote:
      "Cat is the kind of professional that is equal part mentor, educator, and comrade, imbuing her work with a deep sense of empathy necessary to understand a wide gamut of users (even when you think you've servicing a monolithic demographic). What I might have crudely accomplished over time by hitting a piece of granite with a fork, Cat provided a chisel, a strong hammer, and an experienced delicacy.",
    name: "Nick Concklin",
    role: "Creative Director, Fantasy Life",
  },
  {
    quote:
      "Cat was fantastic to work with. A detail-oriented and creative thinker, she helped push our product forward. She asked questions I wouldn't think of, which led to the best experience possible.",
    name: "Eliot Crist",
    role: "CEO, Fantasy Life",
  },
  {
    quote:
      "Cat coordinated a robust volunteer tech support program for the Lawyers' Committee for Civil Right's Election Protection Hotline efforts in 2024. She recruited, onboarded, and scaled our tech volunteers to successfully support 4,000 legal volunteers. Throughout the process Cat showed commitment, skill, follow-through, and generally improved and streamlined the program. It was a pleasure working with her and I hope our paths cross again in the future.",
    name: "John Winters",
    role: "IT Lead, Election Protection Hotline",
  },
];
---

<Layout>
  <Nav />

  <SquiggleLine
    orientation="vertical"
    fixed
    side="left"
    rail={260}
    inset="var(--edge)"
    amplitude={64}
    reach={0.19}
    loops={2.6}
    strands={1}
    colors={["currentColor"]}
    anchor=".logo"
    venn
  />

  <main id="main" class="wrap">
    <section id="hero" class="hero">
      <div class="headline">
        <h1>Hi! I'm Cat Tran.</h1>
        <p class="tagline">
          I design kind, effortless experiences and robust systems for rapidly
          scaling organizations.
        </p>
      </div>

      <dl class="meta">
        {
          meta.map((row) => (
            <div class="row">
              <dt>{row.label}</dt>
              <dd>
                {row.parts.map((p, i) => (
                  <>
                    {i > 0 && (
                      <>
                        <span class="vh">, </span>
                        <svg class="sep" viewBox="0 0 32 29" aria-hidden="true">
                          <path d="M16 27C16 27 2.5 18.5 2.5 9.5C2.5 4.8 6 2 9.8 2C12.7 2 15 4 16 6.2C17 4 19.3 2 22.2 2C26 2 29.5 4.8 29.5 9.5C29.5 18.5 16 27 16 27Z" />
                        </svg>
                      </>
                    )}
                    <b>{p}</b>
                  </>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <VennDivider variant={0} />

    <section id="case-studies" class="case-studies">
      <h2 class="eyebrow">Case studies</h2>
      <ol class="cs-grid">
        {
          caseStudies.map((c) => {
            const href = c.slug ?? c.external?.href;
            const Tag = href ? "a" : "div";
            const linkAttrs = c.external
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {};
            return (
              <li class:list={["cs-card", { "is-minor": c.minor }]}>
                <Tag class="cs-link" href={href} {...linkAttrs}>
                  <div
                    class:list={["cs-thumb", { "has-edge": c.logo?.edge }]}
                    style={`--tint:${c.tint};${c.ratio ? `aspect-ratio:${c.ratio};` : ""}`}
                  >
                    {c.logo ? (
                      <img
                        class:list={["cs-logo", { "is-cover": c.logo.cover }]}
                        src={c.logo.src}
                        alt={c.logo.alt ?? ""}
                        width={c.logo.width}
                        height={c.logo.height}
                        loading="lazy"
                      />
                    ) : (
                      <span class="cs-name" aria-hidden="true">
                        {c.client}
                      </span>
                    )}
                  </div>
                  <div class="cs-caption">
                    <div class="cs-caption-main">
                      <p class="cs-client">{c.client}</p>
                      <h3 class="cs-title">
                        {c.title}
                        {c.locked && (
                          <>
                            <svg
                              class="cs-ext cs-lock"
                              viewBox="0 0 16 16"
                              aria-hidden="true"
                            >
                              <rect x="3.5" y="7" width="9" height="6.5" rx="1.5" />
                              <path d="M5.5 7V5.2a2.5 2.5 0 0 1 5 0V7" />
                            </svg>
                            <span class="vh"> (password protected)</span>
                          </>
                        )}
                        {c.note && (
                          <>
                            {" "}
                            <span class="cs-note">({c.note})</span>
                          </>
                        )}
                        {c.external && (
                          <>
                            <svg
                              class="cs-ext"
                              viewBox="0 0 16 16"
                              aria-hidden="true"
                            >
                              <path d="M5.5 4.5h6v6M11.5 4.5l-7 7" />
                            </svg>
                            <span class="vh"> (opens in a new tab)</span>
                          </>
                        )}
                      </h3>
                      {c.external && (
                        <span class="cs-pub">{c.external.label}</span>
                      )}
                    </div>
                    <span class="cs-meta">{c.meta}</span>
                  </div>
                </Tag>
              </li>
            );
          })
        }
      </ol>
    </section>

    <VennDivider variant={1} />

    <section id="nice-words" class="testimonials">
      <h2 class="eyebrow">Nice words</h2>
      <div class="carousel">
        <button
          type="button"
          class="car-arrow car-prev"
          id="car-prev"
          aria-label="Previous testimonials"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M15 5l-7 7 7 7"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </button>
        <div class="car-viewport">
          <div class="car-track" id="car-track">
            {
              testimonials.slice(0, 3).map((t) => (
                <figure class="testimonial">
                  <div class="t-bubble">
                    <blockquote>
                      <p>&ldquo;{t.quote}&rdquo;</p>
                    </blockquote>
                  </div>
                  <figcaption>
                    <span class="t-name">{t.name}</span>
                    {t.role && <span class="t-role">{t.role}</span>}
                  </figcaption>
                </figure>
              ))
            }
          </div>
        </div>
        <button
          type="button"
          class="car-arrow car-next"
          id="car-next"
          aria-label="Next testimonials"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M9 5l7 7-7 7"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </button>
      </div>
    </section>

    <VennDivider variant={2} />

    <section id="about" class="about">
      <h2 class="eyebrow">About</h2>
      <div class="about-grid">
        <img
          class="about-photo"
          src="/about/cat.jpg"
          alt="Portrait of Cat at home, with houseplants in the background"
          width="750"
          height="1000"
          loading="lazy"
        />
        <div class="about-copy">
          <p class="about-lead">
            The messier the problem the better.
          </p>
          <p>
            Over the course of my 10-year career spanning CX and UX, I've
            gravitated toward small organizations experiencing rapid growth
            where I can develop new systems that make everyone's lives easier.
            For the last 6 years, I've been working in high-stakes environments
            like government and healthcare. Right now, I'm focused on
            building AI-first design process that minimizes tedium and
            maximizes judgment.
          </p>
          <p>
            Outside of work, you'll usually find me out in nature with my dog,
            Alvin, reading, or digging through vintage and antique shops for
            something with a story.
          </p>
        </div>
      </div>
    </section>

    <VennDivider variant={3} />

    <section id="contact" class="contact">
      <h2 class="eyebrow">Contact</h2>
      <ul class="contact-links">
        {
          contacts.map((c) => (
            <li>
              <span class="contact-k">{c.k}</span>
              <a
                href={c.href}
                {...(c.external
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
              >
                {c.label}
                {c.external && (
                  <>
                    <svg class="cs-ext" viewBox="0 0 16 16" aria-hidden="true">
                      <path d="M5.5 4.5h6v6M11.5 4.5l-7 7" />
                    </svg>
                    <span class="vh"> (opens in a new tab)</span>
                  </>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Layout>

<script define:vars={{ testimonials }}>
  const track = document.getElementById("car-track");
  const prevBtn = document.getElementById("car-prev");
  const nextBtn = document.getElementById("car-next");
  const total = testimonials.length;
  let index = 0;

  function escapeHtml(str) {
    const div = document.createElement("div");
    div.textContent = str;
    return div.innerHTML;
  }

  const pageSize = 3;

  function page(start) {
    return Array.from(
      { length: pageSize },
      (_, i) => testimonials[(start + i) % total],
    );
  }

  function cardsHtml(list) {
    return list
      .map(
        (t) => `
          <figure class="testimonial">
            <div class="t-bubble">
              <blockquote><p>&ldquo;${escapeHtml(t.quote)}&rdquo;</p></blockquote>
            </div>
            <figcaption>
              <span class="t-name">${escapeHtml(t.name)}</span>
              ${t.role ? `<span class="t-role">${escapeHtml(t.role)}</span>` : ""}
            </figcaption>
          </figure>`,
      )
      .join("");
  }

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  let animating = false;

  function go(direction) {
    if (animating) return;

    const nextIndex =
      (index + direction * pageSize + total * pageSize) % total;
    const stacked = getComputedStyle(track).flexDirection === "column";

    if (prefersReducedMotion || stacked) {
      index = nextIndex;
      track.innerHTML = cardsHtml(page(index));
      return;
    }

    animating = true;
    const viewportWidth = track.parentElement.clientWidth;
    const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
    const cardWidth = (viewportWidth - gap * (pageSize - 1)) / pageSize;
    const shift = viewportWidth + gap;

    const current = page(index);
    const incoming = page(nextIndex);
    track.innerHTML = cardsHtml(
      direction > 0 ? [...current, ...incoming] : [...incoming, ...current],
    );
    for (const card of track.children) {
      card.style.flex = `0 0 ${cardWidth}px`;
    }

    track.style.transition = "none";
    track.style.transform =
      direction > 0 ? "translateX(0)" : `translateX(${-shift}px)`;
    void track.offsetWidth;
    track.style.transition = "";
    track.style.transform =
      direction > 0 ? `translateX(${-shift}px)` : "translateX(0)";

    const fallback = setTimeout(settle, 700);
    function settle(e) {
      if (e && e.target !== track) return;
      clearTimeout(fallback);
      track.removeEventListener("transitionend", settle);
      index = nextIndex;
      track.style.transition = "none";
      track.style.transform = "";
      track.innerHTML = cardsHtml(page(index));
      void track.offsetWidth;
      track.style.transition = "";
      animating = false;
    }
    track.addEventListener("transitionend", settle);
  }

  prevBtn.addEventListener("click", () => go(-1));
  nextBtn.addEventListener("click", () => go(1));
</script>

<style>
  .wrap {
    position: relative;
    z-index: 2;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 clamp(28px, 5vw, 88px) 0
      calc(var(--edge) + clamp(240px, 16vw, 268px));
    color: var(--ink);
  }
  .hero {
    padding: 22vh 0 6vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 40px;
  }
  .headline {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--terracotta);
  }
  .tagline {
    font-family: var(--font-serif);
    font-size: clamp(20px, 2.4vw, 28px);
    line-height: 1.4;
    letter-spacing: -0.01em;
    margin: 0;
    max-width: 40ch;
    color: var(--ink);
  }
  .meta {
    margin: 0;
    max-width: 920px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: 10px;
    font-family: var(--font-sans);
    font-size: 14px;
  }
  .row {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 10px 16px 12px;
    border: 1px solid var(--hairline);
    border-radius: 12px;
    background: var(--surface);
    text-align: center;
  }
  dt {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--terracotta-ink);
    margin-bottom: 4px;
  }
  dd {
    margin: 0;
    color: var(--ink);
    font-weight: 500;
  }
  dd b {
    font-weight: 500;
  }
  .sep {
    width: 9px;
    height: 9px;
    margin: 0 6px;
    fill: var(--terracotta-ink);
    vertical-align: -1px;
  }
  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .eyebrow {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--terracotta-ink);
    margin: 0;
  }

  .case-studies {
    padding: 5vh 0 4vh;
  }
  .cs-grid {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    columns: 2;
    column-gap: clamp(20px, 3vw, 44px);
  }
  .cs-card {
    break-inside: avoid;
    margin-bottom: clamp(34px, 5vw, 60px);
  }
  .cs-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .cs-link .cs-thumb {
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  a.cs-link:hover .cs-thumb {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px var(--shadow);
  }
  a.cs-link:hover .cs-title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  a.cs-link:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 6px;
    border-radius: 16px;
  }
  @media (prefers-reduced-motion: reduce) {
    a.cs-link:hover .cs-thumb {
      transform: none;
    }
  }
  .cs-thumb {
    background: var(--tint, #e5ddcd);
    border-radius: 14px;
    aspect-ratio: 2 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .cs-card:nth-child(3n + 2) .cs-thumb {
    aspect-ratio: 1 / 1;
  }
  .cs-card:nth-child(4n + 1) .cs-thumb {
    aspect-ratio: 4 / 3;
  }
  .cs-name {
    font-family: var(--font-serif);
    font-size: clamp(17px, 2.1vw, 24px);
    line-height: 1.22;
    letter-spacing: -0.01em;
    text-align: center;
    text-wrap: balance;
    color: #2a2724;
    padding: 24px;
  }

  .cs-thumb.has-edge {
    outline: 1px solid var(--hairline);
    outline-offset: -1px;
  }
  .cs-logo {
    display: block;
    width: auto;
    height: auto;
    max-width: 72%;
    max-height: 56%;
    object-fit: contain;
  }
  .cs-card.is-minor .cs-logo:not(.is-cover) {
    max-width: 50%;
  }
  .cs-logo.is-cover {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
  }

  .cs-card.is-minor .cs-thumb {
    aspect-ratio: 3 / 1;
  }
  .cs-card.is-minor .cs-name {
    font-size: 15px;
    padding: 16px;
  }
  .cs-card.is-minor .cs-caption {
    margin-top: 11px;
  }
  .cs-card.is-minor .cs-title {
    font-size: 15px;
  }
  .cs-card.is-minor .cs-meta {
    font-size: 12px;
  }

  .cs-caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-top: 15px;
  }
  .cs-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(17px, 1.7vw, 21px);
    line-height: 1.3;
    margin: 0;
    color: var(--ink);
    text-wrap: balance;
  }
  .cs-meta {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--warm-grey);
    white-space: nowrap;
    flex: none;
  }
  .cs-caption-main {
    min-width: 0;
  }
  .cs-client {
    margin: 0 0 4px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
